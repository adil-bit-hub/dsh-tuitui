{
  "name": "dsh-tuitui",
  "version": "0.3.0",
  "description": "把 360 推推（Tuitui）IM 机器人接入 DeepSeek Harness：管理员使用完整 agent，成员仅问答且无工具/技能；可在设置页启用、停止与删除。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./member-guard": "./lib/member-guard.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adil-bit-hub/dsh-tuitui.git"
  },
  "homepage": "https://github.com/adil-bit-hub/dsh-tuitui#readme",
  "bugs": {
    "url": "https://github.com/adil-bit-hub/dsh-tuitui/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "tuitui",
    "im-bot",
    "360 推推",
    "chatbot"
  ],
  "author": "adil-bit-hub",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node plugin-src/host/build.mjs && node plugin-src/client/build.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@qihoo/tuitui-bot-sdk": "1.0.19",
    "esbuild": "0.25.9"
  }
}
